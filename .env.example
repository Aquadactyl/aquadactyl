APP_ENV=production
APP_NAME=Aquadactyl
APP_DEBUG=false
APP_KEY=
APP_THEME=pterodactyl
APP_TIMEZONE=UTC
APP_URL=https://panel.example.com
# Comma-separated IP addresses or CIDRs of proxies allowed to set forwarded headers.
TRUSTED_PROXIES=
APP_LOCALE=en
APP_ENVIRONMENT_ONLY=true

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=7

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=panel
DB_USERNAME=aquadactyl
DB_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
ADDONS_HOOKS_ENABLED=false
# Opt-in admin uploads; requires the dedicated root Blueprint installer service.
AQUADACTYL_BLUEPRINT_WEB_INSTALL_ENABLED=false

# Defaults for environment-only deployments; otherwise configurable in Admin > Settings > PWA.
AQUADACTYL_PWA_ENABLED=true
AQUADACTYL_PWA_OFFLINE_ENABLED=true
AQUADACTYL_PWA_APP_NAME=
AQUADACTYL_PWA_SHORT_NAME=

# Maximum file size for the web editor and image previews, in bytes (32 MiB).
PTERODACTYL_FILES_MAX_EDIT_SIZE=33554432

# Optional Aquadactyl telemetry. Disabled unless enabled in Admin settings.
AQUADACTYL_TELEMETRY_ENABLED=false
AQUADACTYL_TELEMETRY_ENDPOINT=https://api.euphoriadevelopment.uk/telemetry/panel
AQUADACTYL_DEBUG_ENDPOINT=https://debug.euphoriadevelopment.uk
AQUADACTYL_DEBUG_EXPIRES_IN=86400
AQUADACTYL_DEBUG_MAX_BYTES=262144

HASHIDS_SALT=
HASHIDS_LENGTH=8

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=25
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="Aquadactyl Panel"
# You should set this to your domain to prevent it defaulting to 'localhost', causing
# mail servers such as Gmail to reject your mail.
#
# @see: https://github.com/pterodactyl/panel/pull/3110
# MAIL_EHLO_DOMAIN=panel.example.com
