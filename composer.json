{
  "name": "aquadactyl/panel",
  "description": "Aquadactyl game server management panel, an independent Pterodactyl fork with Blueprint bundled.",
  "homepage": "https://aquadactyl.uk",
  "license": "MIT",
  "authors": [
    {
      "name": "RepGraphics",
      "email": "repgraphics@euphoriadevelopment.uk",
      "homepage": "https://github.com/RepGraphics",
      "role": "Lead Developer"
    },
    {
      "name": "KingIronMan2011",
      "email": "contact@kingironman.dev",
      "homepage": "https://kingironman.dev",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "~8.4.0 || ~8.5.0",
    "ext-gd": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-posix": "*",
    "ext-zip": "*",
    "aws/aws-sdk-php": "^3.400.1",
    "guzzlehttp/guzzle": "^7.15.5",
    "hashids/hashids": "^5.0.2",
    "laracasts/utilities": "~3.2.5",
    "laravel/framework": "^12.69.3",
    "laravel/helpers": "^1.8.3",
    "laravel/sanctum": "^4.3.3",
    "laravel/tinker": "^3.0.2",
    "laravel/ui": "~4.6.3",
    "lcobucci/jwt": "^5.6.1",
    "league/flysystem-aws-s3-v3": "^3.35.3",
    "league/flysystem-memory": "^3.31.0",
    "matriphe/iso-639": "~2.0.10",
    "phpseclib/phpseclib": "^4.0.2",
    "pragmarx/google2fa": "~9.1.0",
    "predis/predis": "^3.7.0",
    "prologue/alerts": "^1.4.0",
    "psr/cache": "^3.0.0",
    "s1lentium/iptools": "~1.2.0",
    "spatie/laravel-fractal": "^6.4.0",
    "spatie/laravel-query-builder": "^7.3.5",
    "staudenmeir/belongs-to-through": "^2.17.0",
    "symfony/http-client": "^7.4.20",
    "symfony/mailgun-mailer": "^7.4.18",
    "symfony/postmark-mailer": "^7.4.18",
    "symfony/yaml": "^7.4.20",
    "webmozart/assert": "^2.5.0"
  },
  "require-dev": {
    "barryvdh/laravel-ide-helper": "^3.7.0",
    "fakerphp/faker": "^1.24.1",
    "itsgoingd/clockwork": "^5.3.5",
    "larastan/larastan": "^3.13.0",
    "laravel/pint": "^1.32.1",
    "mockery/mockery": "^1.6.15",
    "nunomaduro/collision": "^8.9.5",
    "pestphp/pest": "^3.8.7",
    "pestphp/pest-plugin-laravel": "^3.2.0",
    "phpstan/phpstan": "^2.3.1",
    "phpstan/phpstan-webmozart-assert": "^2.0",
    "spatie/laravel-ignition": "^2.12.0"
  },
  "autoload": {
    "files": [
      "app/helpers.php"
    ],
    "psr-4": {
      "Pterodactyl\\": "app/",
      "Database\\Factories\\": "database/Factories/",
      "Database\\Seeders\\": "database/Seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Pterodactyl\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "pest",
    "cs:fix": "pint",
    "cs:check": "pint --test",
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi || true"
    ],
    "post-install-cmd": [
      "@php artisan p:environment:addons:run-hooks post-install || true"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi",
      "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
      "@php artisan migrate --graceful --ansi"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "platform": {
      "php": "8.4.0"
    },
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
